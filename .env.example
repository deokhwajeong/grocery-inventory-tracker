# Example environment configuration for Grocery Inventory Tracker.
# Copy this file to .env and adjust as needed. All values are optional in development.

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security: required when FLASK_ENV=production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Storage (relative paths resolve against the current directory)
DATABASE_PATH=groceries.db
UPLOAD_FOLDER=uploads

# OCR: languages that are not installed are skipped automatically
OCR_LANGUAGES=eng+kor

# Items expiring within this many days are flagged on the dashboard
EXPIRY_WARNING_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
