"""
Example environment configuration file for Grocery Inventory Tracker.
Copy this file to .env and customize the values as needed.
"""

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Security
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-replace-in-production

# Database
DATABASE_PATH=groceries.db

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB in bytes

# OCR Settings
OCR_LANGUAGES=eng+kor
OCR_TIMEOUT=30

# Expiry Settings
EXPIRY_WARNING_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
