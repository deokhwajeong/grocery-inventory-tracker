# Example environment configuration for Grocery Inventory Tracker.
# Copy this file to .env and adjust as needed. All values are optional in development.

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security: required when FLASK_ENV=production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Storage (relative paths resolve against the current directory)
DATABASE_PATH=groceries.db
UPLOAD_FOLDER=uploads

# Receipt images: kept for the review page and receipt history, shrunk to
# RECEIPT_MAX_DIMENSION pixels, newest RECEIPT_KEEP per household
RECEIPT_FOLDER=uploads/receipts
STORE_RECEIPT_IMAGES=true
RECEIPT_MAX_DIMENSION=1600
RECEIPT_KEEP=100
MAX_UPLOAD_MB=16

# Batch receipt upload limit
BATCH_MAX_FILES=10

# Barcode lookup: the bundled offline catalog is always used. Set to true to
# also look up unknown codes on Open Food Facts (needs internet access).
BARCODE_ONLINE_LOOKUP=false
BARCODE_LOOKUP_TIMEOUT=4

# OCR: languages that are not installed are skipped automatically
OCR_LANGUAGES=eng+kor

# Items expiring within this many days are flagged on the dashboard
EXPIRY_WARNING_DAYS=7

# Logging
LOG_LEVEL=INFO
LOG_FILE=app.log
